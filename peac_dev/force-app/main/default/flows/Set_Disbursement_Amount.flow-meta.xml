    <description>Sets Repayment and Disbursement for Loans - Update to force recalculation of Disbursement amount even if repayment changes.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>[Opportunity].Max_Payback__c  * [Opportunity].Max_Rate__c </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_2_myRule_1_A1_8108346372</name>
        <dataType>Currency</dataType>
        <expression>{!myVariable_current.Max_Payback__c}  * {!myVariable_current.Max_Rate__c}</expression>
        <scale>18</scale>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>[Opportunity].Loan_Amount__c - 
IF(!ISBLANK([Opportunity].Origination_Amount__c), [Opportunity].Origination_Amount__c,0)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_5_myRule_4_A1_1628929526</name>
        <dataType>Currency</dataType>
        <expression>{!myVariable_current.Loan_Amount__c} - 
IF(!ISBLANK({!myVariable_current.Origination_Amount__c}), {!myVariable_current.Origination_Amount__c},0)</expression>
        <scale>18</scale>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>[Opportunity].Loan_Amount__c - 
IF(!ISBLANK([Opportunity].Origination_Amount__c), [Opportunity].Origination_Amount__c,0) - 
IF(!ISBLANK([Opportunity].Renewal_Payoff_Amount__c) ,[Opportunity].Renewal_Payoff_Amount__c,0) - 
IF(!ISBLANK([Opportunity].Competitor_Payoff_Amount__c), [Opportunity].Competitor_Payoff_Amount__c,0)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_8_myRule_7_A1_5543092321</name>
        <dataType>Currency</dataType>
        <expression>{!myVariable_current.Loan_Amount__c} - 
IF(!ISBLANK({!myVariable_current.Origination_Amount__c}), {!myVariable_current.Origination_Amount__c},0) - 
IF(!ISBLANK({!myVariable_current.Renewal_Payoff_Amount__c}) ,{!myVariable_current.Renewal_Payoff_Amount__c},0) - 
IF(!ISBLANK({!myVariable_current.Competitor_Payoff_Amount__c}), {!myVariable_current.Competitor_Payoff_Amount__c},0)</expression>
        <scale>18</scale>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR(
   AND(
      ISNEW(),
     !ISBLANK([Opportunity].Max_Payback__c ),
     !ISBLANK([Opportunity].Max_Rate__c),
     [Opportunity].Max_Payback__c&gt; 0,
     [Opportunity].Loan_Record_Type__c = TRUE
   ),
   AND(
     !ISBLANK([Opportunity].Max_Payback__c),
     !ISBLANK([Opportunity].Max_Rate__c),
     [Opportunity].Max_Payback__c &gt; 0,
     [Opportunity].Loan_Record_Type__c = TRUE,
     OR(
        ISCHANGED([Opportunity].Max_Payback__c),
        ISCHANGED([Opportunity].Max_Rate__c),
        ISBLANK([Opportunity].Repayment_Amount__c)
     )
   )
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>OR(
   AND(
