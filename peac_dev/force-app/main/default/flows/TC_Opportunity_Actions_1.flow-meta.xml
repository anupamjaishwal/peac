    <description>Migrated from the !TC Opportunity Actions process using multiple criteria.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_TRUE_myRule_26</name>
        <dataType>Boolean</dataType>
        <expression>(
   ISCHANGED({!$Record.StageName} )
   ||
   ISCHANGED({!$Record.Purchase_Options__c})
   ||
   ISCHANGED({!$Record.FL_Doc_St_Tax_Misc_Invoice__c})
   ||
   ISCHANGED({!$Record.Sum_of_Florida_Asset_Rental_Amounts__c})
)
&amp;&amp;
TEXT({!$Record.StageName} ) = &quot;Booking&quot;
&amp;&amp;
!{!$Record.Loan_Record_Type__c} 
&amp;&amp;
!CONTAINS(TEXT({!$Record.Purchase_Options__c}), &quot;FMV&quot;)
&amp;&amp;
TEXT({!$Record.Purchase_Options__c}) &lt;&gt; &quot;Customer Owned&quot;
&amp;&amp;
ISBLANK({!$Record.FL_Doc_St_Tax_Misc_Invoice__c})
&amp;&amp;
{!$Record.Sum_of_Florida_Asset_Rental_Amounts__c} &gt; 0</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_28</name>
        <dataType>Boolean</dataType>
        <expression>!ISBLANK({!$Record.FL_Doc_St_Tax_Misc_Invoice__c})
&amp;&amp;
{!$Record.FL_Doc_St_Tax_Misc_Invoice__c.Amount__c}  &lt;&gt; {!$Record.Sum_of_Florida_Asset_Rental_Amounts__c} 
&amp;&amp;
ISCHANGED({!$Record.Sum_of_Florida_Asset_Rental_Amounts__c} )</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_36</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Loan_Record_Type__c}
&amp;&amp;
{!$Record.No_Pymts_Released_or_Acknowledged__c} &gt; 0
&amp;&amp;
{!$Record.No_Pymts_Not_Released_or_Acknowledged__c} = 0
&amp;&amp;
TEXT({!$Record.StageName}) = &quot;Funding (Loan)&quot;
&amp;&amp;
$Setup.ORE__c.Bypass__c = false</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_38</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Loan_Record_Type__c}
&amp;&amp;
{!$Record.No_Pymts_Released_or_Acknowledged__c} &gt; 0
&amp;&amp;
{!$Record.No_Pymts_Not_Released_or_Acknowledged__c} = 0
&amp;&amp;
TEXT({!$Record.StageName}) = &quot;Funding (Loan)&quot;
&amp;&amp;
$Setup.ORE__c.Bypass__c = true</expression>
    </formulas>
    <formulas>
        <name>now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
