        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Should_It_Be_Updated</name>
            <conditionLogic>(1 AND 3) OR (2 AND 4)</conditionLogic>
            <conditions>
