    <description>Copy Account Billing Address from Business address. SAL-4431</description>
    <environments>Default</environments>
    <formulas>
        <name>DocsRequestedandnobilling</name>
        <dataType>Boolean</dataType>
        <expression>AND(
   OR(
    ISBLANK({!$Record.Account_Billing_State_Province__c}),
    ISBLANK({!$Record.Account_Billing_Zip_Postal_Code__c}),
	ISBLANK({!$Record.Account_Billing_Street__c}),
	ISBLANK({!$Record.Account_Billing_City__c})
   ),
   OR(
	!ISBLANK({!$Record.Account_Business_State_Province__c}),
	!ISBLANK({!$Record.Account_Business_Street__c}),
	!ISBLANK({!$Record.Account_Business_Zip_Postal_Code__c}),
    !ISBLANK({!$Record.Account_Business_City__c})	
   ) ,
   OR(
CONTAINS( {!$Label.PEAC_Copy_Billing_Address_Stages},TEXT({!$Record.StageName})) 
)
)</expression>
    </formulas>
