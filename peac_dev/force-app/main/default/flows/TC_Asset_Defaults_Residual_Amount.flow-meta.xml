    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>TEXT([Asset__c].Opportunity__r.Purchase_Options__c) &lt;&gt; &quot;1.00 Out&quot;
&amp;&amp;
TEXT([Asset__c].Opportunity__r.Purchase_Options__c) &lt;&gt; &quot;Assign Resid No Renewal&quot;
&amp;&amp;
TEXT([Asset__c].Opportunity__r.Purchase_Options__c) &lt;&gt; &quot;Assigned Residual&quot;
&amp;&amp;
TEXT( [Asset__c].Opportunity__r.Purchase_Options__c) &lt;&gt; &quot;Customer Owned&quot;
&amp;&amp;
(
  (
	 ISNEW()
	 &amp;&amp;
	 [Asset__c].Residual_Percentage__c &gt;= 0
	 &amp;&amp;
	 [Asset__c].List_Price__c &gt;= 0
  )
  ||
  (
	 [Asset__c].Residual_Percentage__c &gt;= 0
	 &amp;&amp;
	 [Asset__c].List_Price__c &gt;= 0
	 &amp;&amp;
	 (
		ISCHANGED([Asset__c].Residual_Percentage__c)
		||
		ISCHANGED([Asset__c].List_Price__c)
	 )		 
  )	  

)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>TEXT({!myVariable_current.Opportunity__r.Purchase_Options__c}) &lt;&gt; &quot;1.00 Out&quot;
&amp;&amp;
TEXT({!myVariable_current.Opportunity__r.Purchase_Options__c}) &lt;&gt; &quot;Assign Resid No Renewal&quot;
&amp;&amp;
TEXT({!myVariable_current.Opportunity__r.Purchase_Options__c}) &lt;&gt; &quot;Assigned Residual&quot;
&amp;&amp;
TEXT( {!myVariable_current.Opportunity__r.Purchase_Options__c}) &lt;&gt; &quot;Customer Owned&quot;
&amp;&amp;
(
  (
	 ISNEW()
	 &amp;&amp;
	 {!myVariable_current.Residual_Percentage__c} &gt;= 0
	 &amp;&amp;
	 {!myVariable_current.List_Price__c} &gt;= 0
  )
  ||
  (
	 {!myVariable_current.Residual_Percentage__c} &gt;= 0
	 &amp;&amp;
	 {!myVariable_current.List_Price__c} &gt;= 0
	 &amp;&amp;
	 (
		ISCHANGED({!myVariable_current.Residual_Percentage__c})
		||
		ISCHANGED({!myVariable_current.List_Price__c})
	 )		 
  )	  

)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND (
	[Asset__c].Residual_Percentage__c &gt; 0, 
	OR(
		TEXT([Asset__c].Opportunity__r.Purchase_Options__c) = &quot;1.00 Out&quot;,
		TEXT([Asset__c].Opportunity__r.Purchase_Options__c) = &quot;Assign Resid No Renewal&quot;,
		TEXT([Asset__c].Opportunity__r.Purchase_Options__c) = &quot;Assigned Residual&quot;,
	    TEXT([Asset__c].Opportunity__r.Purchase_Options__c) = &quot;Customer Owned&quot;
	)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_4</name>
        <dataType>Boolean</dataType>
        <expression>AND (
	{!myVariable_current.Residual_Percentage__c} &gt; 0, 
	OR(
		TEXT({!myVariable_current.Opportunity__r.Purchase_Options__c}) = &quot;1.00 Out&quot;,
