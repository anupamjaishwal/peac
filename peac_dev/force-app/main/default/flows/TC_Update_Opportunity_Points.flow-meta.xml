    <decisions>
        <name>Check_Opps</name>
        <label>Check Opps</label>
        <locationX>1050</locationX>
        <locationY>376</locationY>
        <defaultConnector>
            <targetReference>Each_Dealer</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check</name>
            <conditionLogic>((1 AND 2 AND 7) OR (8) ) AND (3 OR 4 OR 5 OR 6)</conditionLogic>
            <conditions>
                <leftValueReference>Each_Dealer.Opportunity__r.EF_Approved_Offers__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Each_Dealer.Opportunity__r.record_type_name__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Express</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Each_Dealer.Opportunity__r.Points__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Each_Dealer.Points__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Each_Dealer.Opportunity__r.Points__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Each_Dealer.Opportunity__r.Number_of_Dealers__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Each_Dealer.Opportunity__r.Points__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AccountsOldPoints</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Each_Dealer.Opportunity__r.Document_Delivery_Method__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DocuSign</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Each_Dealer.Opportunity__r.Dealer_User__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Value_for_Opportunity</targetReference>
            </connector>
            <label>Check</label>
        </rules>
    </decisions>
