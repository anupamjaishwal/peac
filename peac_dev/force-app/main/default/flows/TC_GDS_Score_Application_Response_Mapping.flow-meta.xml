        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formNumOfAdvancePayments</name>
        <dataType>Number</dataType>
        <expression>IF(
	AND(
	!ISBLANK ({!varAppResponse.Ud_Payments_Upfront__c}),
	CONTAINS(Lower({!varOpp.Equip_Code1__c}), Lower(&apos;medical&apos;)) 
	),
	VALUE({!varAppResponse.Ud_Payments_Upfront__c}),
	0
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formPersonalInfo</name>
        <dataType>Boolean</dataType>
        <expression>!ISBLANK({!varAppResponse.Ud_Min_Personal_Info__c}) &amp;&amp; {!varAppResponse.Ud_Min_Personal_Info__c} == &apos;1&apos;</expression>
    </formulas>
    <formulas>
        <name>formRestrictedEquipment</name>
        <dataType>String</dataType>
        <expression>CASE ({!varAppResponse.Restricted_Equip__c}
,&apos;1&apos;,&apos;Restricted&apos;
,&apos;0&apos;,&apos;Not Restricted&apos;
,&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>formSecurityDepostPayments</name>
        <dataType>Number</dataType>
        <expression>IF(
	AND(
	!ISBLANK ({!varAppResponse.Ud_Payments_Upfront__c}),
	NOT(CONTAINS(Lower({!varOpp.Equip_Code1__c}), Lower(&apos;medical&apos;)) )
	),
	VALUE({!varAppResponse.Ud_Payments_Upfront__c}),
	0
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formSFPModel</name>
        <dataType>Boolean</dataType>
        <expression>!ISBLANK({!varAppResponse.ud_SFP_Model__c}) &amp;&amp;  {!varAppResponse.ud_SFP_Model__c} == &apos;1&apos;</expression>
    </formulas>
    <formulas>
        <name>formSicCreditState</name>
        <dataType>String</dataType>
        <expression>CASE ({!varAppResponse.SICCODE_Preference_Input__c}
,&apos;P&apos;,&apos;Preferred&apos;
