    <formulas>
        <name>formApprovedReason</name>
        <dataType>String</dataType>
        <expression>CASE ({!varAppResponse.Ud_Approved_Reason__c}
   ,&apos;AA&apos;, &apos;Auto Approval&apos;
   ,&apos;ASFP&apos;, &apos;Approved SFP Tier 2&apos;
   ,&apos;IAD&apos; , &apos;Instant Auto Decision&apos;
   ,&apos;NFR&apos;, &apos;Approved with Supplemental Information&apos;
   ,&apos;SCQ&apos; ,&apos;Satisfactory Credit Quality&apos;
   ,null)</expression>
    </formulas>
    <formulas>
        <name>formAutoMoreInfo</name>
