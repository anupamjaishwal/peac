    </formulas>
    <formulas>
        <name>formBankInfo</name>
        <dataType>Boolean</dataType>
        <expression>!ISBLANK({!varAppResponse.Ud_Min_Personal_Info__c}) &amp;&amp; {!varAppResponse.Ud_Min_Personal_Info__c} == &apos;1&apos;</expression>
    </formulas>
    <formulas>
