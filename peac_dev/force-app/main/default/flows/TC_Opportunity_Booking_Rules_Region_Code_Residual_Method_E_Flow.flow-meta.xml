<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <decisions>
        <name>Lessor_Code</name>
        <label>Lessor Code</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Lessor_Code_4xx</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lessor__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>400.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lessor__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>500.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Marlin_Business_Bank_Residual_Method_e</targetReference>
            </connector>
            <label>Lessor Code 4xx</label>
        </rules>
        <rules>
            <name>Lessor_Code_Not_4xx</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lessor__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Lessor Code Not 4xx</label>
        </rules>
    </decisions>
    <description>Automatically assigns the Region field on Opportunity based on the Lessor and Program values using custom metadata mappings. Allows authorized users with Admin or Booking profiles to manually override the Region field. If the Region is overridden, the system will skip auto-updating it. SAL-5314</description>
    <environments>Default</environments>
    <interviewLabel>TC Opportunity: Booking Rules - Region Code/Residual Method E Flow {!$Flow.CurrentDateTime}</interviewLabel>
