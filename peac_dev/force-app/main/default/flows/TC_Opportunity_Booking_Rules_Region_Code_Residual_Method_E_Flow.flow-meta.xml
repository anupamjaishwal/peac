            <targetReference>Lessor_Code</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Loan_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Opportunity_CurrentUser_Profile__c</field>
            <operator>NotEqualTo</operator>
