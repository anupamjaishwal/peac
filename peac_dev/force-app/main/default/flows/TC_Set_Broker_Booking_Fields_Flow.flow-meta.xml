        <locationX>50</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Broker_Book_Method__c</field>
            <value>
                <stringValue>F</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Broker_Tax_Method__c</field>
            <value>
                <stringValue>F</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Broker_Defaults_No_Points</name>
        <label>Update Broker Defaults</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Broker_Book_Method__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Broker_Tax_Method__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Points_at_Booking_Stage</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Booking</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
