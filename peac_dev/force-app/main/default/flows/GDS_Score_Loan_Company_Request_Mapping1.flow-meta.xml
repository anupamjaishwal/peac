, 
TEXT(MONTH({!varAcc.Date_Established__c}))+ &quot;/&quot; + TEXT(DAY({!varAcc.Date_Established__c}))+ &quot;/&quot; + TEXT(YEAR({!varAcc.Date_Established__c}))
