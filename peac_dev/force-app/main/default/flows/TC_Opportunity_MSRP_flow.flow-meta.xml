<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <decisions>
        <description>SLG Outcome added for user story SAL-4836.</description>
        <name>Decision</name>
        <label>Decision</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>criteria</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.MSRP__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.MSRP__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Total_Asset_Cost_Sum_from_Assets__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Total_Asset_Cost</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>StageSwitch</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>BranchSwitch</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Branch__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Office Equip Group-OEG</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_application_status_and_stage</targetReference>
            </connector>
            <label>criteria</label>
        </rules>
        <rules>
            <name>SLG_Update_on_Contract</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SLG__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Loan_Record_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contracts</targetReference>
            </connector>
            <label>SLG Update on Contract</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>BranchSwitch</name>
        <dataType>Number</dataType>
        <expression>CASE({!$Record.Branch__c}, &apos;OEG/NATIONAL&apos;,1,&apos;OEG - Major Accounts&apos;,1,&apos;Office Equip Group-OEG&apos;,1,0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>NextDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+1</expression>
    </formulas>
    <formulas>
        <name>StageSwitch</name>
        <dataType>Number</dataType>
        <expression>CASE({!$Record.StageName}, &apos;Proposal&apos;,1,&apos;Docs Requested&apos;, 1, &apos;Docs Out&apos;, 1, &apos;Docs In&apos;, 1, 0 )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Total_Asset_Cost</name>
        <dataType>Number</dataType>
        <expression>1.3*{!$Record.MSRP__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>TC Opportunity - MSRP {!$Flow.CurrentDateTime}</interviewLabel>
