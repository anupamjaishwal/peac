        <locationX>282</locationX>
        <locationY>449</locationY>
        <assignmentItems>
            <assignToReference>$Record.Assigned_to_DM_User__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Label.User_Scorecard</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Dealer_Status</targetReference>
        </connector>
    </assignments>
    <assignments>
