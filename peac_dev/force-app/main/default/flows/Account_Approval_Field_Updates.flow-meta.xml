                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Date_Dealer_Approved_Most_Recent</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Approved_Reason</name>
        <label>Approved Reason</label>
        <locationX>495</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Dealer_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Changed_to_Auto_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Approved_Reason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Auto-Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assigned_to_DM_User_c_to_Scorecard_user</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Auto-Approved</label>
        </rules>
        <rules>
            <name>Auto_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Rejected_Reason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Auto Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assigned_to_DM_User_c_to_Scorecard_user</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Auto Rejected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dealer_Status</name>
        <label>Dealer Status</label>
        <locationX>438</locationX>
        <locationY>626</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Dealer_Status_Approved_First_Time</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Dealer_Status_Approved__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Account_Dealer_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Account_Dealer_Status__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Date_Dealer_Approved_Orig__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Date_Dealer_Approved_Original</targetReference>
            </connector>
            <label>Approved First Time</label>
        </rules>
        <rules>
            <name>Dealer_Status_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Dealer_Status_Approved__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Dealer_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Account_Dealer_Status__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Date_Dealer_Approved_Most_Recent</targetReference>
            </connector>
            <label>Approved (repeat)</label>
        </rules>
    </decisions>
