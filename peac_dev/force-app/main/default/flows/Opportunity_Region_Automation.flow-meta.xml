    <decisions>
        <name>Check_Region_Overridden</name>
        <label>Check Region Overridden</label>
        <locationX>490</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Already_Overridden</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Region_Overridden__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Already Overridden</label>
        </rules>
        <rules>
            <name>Not_Overridden</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Region_Overridden__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Fetch_User_Profile</targetReference>
            </connector>
            <label>Not Overridden</label>
        </rules>
    </decisions>
    <decisions>
        <name>Did_User_Manually_Update_Region</name>
        <label>Did User Manually Update Region?</label>
        <locationX>490</locationX>
        <locationY>503</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Manually_Overridden_by_Authorized_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Label.All_Admin_and_Booking_Profile</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Fetch_User_Profile.Name</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Region__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Region__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Region_Overridden__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Region_Overridden</targetReference>
            </connector>
            <label>Manually Overridden by Authorized User</label>
        </rules>
        <rules>
            <name>Not_Overridden1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lessor_Program_Region_Mappings</targetReference>
            </connector>
            <label>Not Overridden</label>
        </rules>
    </decisions>
    <decisions>
        <description>Evaluate the Opportunity against specific Conditions using the following criteria :</description>
        <name>Evaluate_Opportunity_Conditions</name>
        <label>Evaluate Opportunity Conditions</label>
        <locationX>886</locationX>
        <locationY>827</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_Lessor_Program_Region_Mappings</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Condition_Satisfied</name>
            <conditionLogic>(1 AND 2) OR (1 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_Lessor_Program_Region_Mappings.Lessor__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Lessor__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Program__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Through_Lessor_Program_Region_Mappings.Program__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Through_Lessor_Program_Region_Mappings.Program__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Region_Field</targetReference>
            </connector>
            <label>If Condition Satisfied</label>
        </rules>
    </decisions>
    <description>Automatically assigns the Region field on Opportunity based on the Lessor and Program values using custom metadata mappings. Allows authorized users with Admin or Booking profiles to manually override the Region field. If the Region is overridden, the system will skip auto-updating it. SAL-5314</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity Region Automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Region Automation</label>
    <loops>
        <description>Loop through each record retrieved from the &apos;Lessor Program Region Mappings&apos; custom metadata.</description>
        <name>Loop_Through_Lessor_Program_Region_Mappings</name>
        <label>Loop Through Lessor Program Region Mappings</label>
        <locationX>666</locationX>
        <locationY>719</locationY>
        <collectionReference>Get_Lessor_Program_Region_Mappings</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Evaluate_Opportunity_Conditions</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Default_Region_as_Marlin_Leasing</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Fetch_User_Profile</name>
        <label>Fetch User Profile</label>
        <locationX>490</locationX>
        <locationY>395</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Did_User_Manually_Update_Region</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.ProfileId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Profile</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Fetch all records from the &apos;Lessor Program Region Mapping&apos; custom metadata.</description>
        <name>Get_Lessor_Program_Region_Mappings</name>
        <label>Get Lessor Program Region Mappings</label>
        <locationX>666</locationX>
        <locationY>611</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_Lessor_Program_Region_Mappings</targetReference>
        </connector>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lessor_Program_Region_Mapping__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>364</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Region_Overridden</targetReference>
        </connector>
        <filterLogic>1  OR 2</filterLogic>
