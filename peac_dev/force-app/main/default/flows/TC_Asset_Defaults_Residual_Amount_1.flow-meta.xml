    <description>Migrated from the TC: Asset Defaults - Residual Amount process using multiple criteria.
Default residual amount when resid % is changed</description>
    <formulas>
        <name>formula_1_myRule_1_A1_1558745944</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Residual_Percentage__c} * {!$Record.List_Price__c}</expression>
        <scale>18</scale>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>TEXT({!$Record.Opportunity__r.Purchase_Options__c}) &lt;&gt; &quot;1.00 Out&quot;
&amp;&amp;
TEXT({!$Record.Opportunity__r.Purchase_Options__c}) &lt;&gt; &quot;Assign Resid No Renewal&quot;
&amp;&amp;
TEXT({!$Record.Opportunity__r.Purchase_Options__c}) &lt;&gt; &quot;Assigned Residual&quot;
&amp;&amp;
TEXT( {!$Record.Opportunity__r.Purchase_Options__c}) &lt;&gt; &quot;Customer Owned&quot;
&amp;&amp;
(
  (
	 ISNEW()
	 &amp;&amp;
	 {!$Record.Residual_Percentage__c} &gt;= 0
	 &amp;&amp;
	 {!$Record.List_Price__c} &gt;= 0
  )
  ||
  (
	 {!$Record.Residual_Percentage__c} &gt;= 0
	 &amp;&amp;
	 {!$Record.List_Price__c} &gt;= 0
	 &amp;&amp;
	 (
		ISCHANGED({!$Record.Residual_Percentage__c})
		||
		ISCHANGED({!$Record.List_Price__c})
	 )		 
  )	  

)</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_4</name>
        <dataType>Boolean</dataType>
        <expression>AND (
	{!$Record.Residual_Percentage__c} &gt; 0, 
	OR(
		TEXT({!$Record.Opportunity__r.Purchase_Options__c}) = &quot;1.00 Out&quot;,
		TEXT({!$Record.Opportunity__r.Purchase_Options__c}) = &quot;Assign Resid No Renewal&quot;,
		TEXT({!$Record.Opportunity__r.Purchase_Options__c}) = &quot;Assigned Residual&quot;,
	    TEXT({!$Record.Opportunity__r.Purchase_Options__c}) = &quot;Customer Owned&quot;
	)
)</expression>
    </formulas>
    <label>TC: Asset Defaults - Residual Amount_1</label>
    <processMetadataValues>
