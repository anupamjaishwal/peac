    <description>This flow is used for map opportunity and related object fields into GDS Score object record while making gds callout.</description>
    <environments>Default</environments>
    <formulas>
        <name>DWHFlag</name>
        <dataType>String</dataType>
        <expression>IF({!TotalStoreProcedures} == 2,&apos;N&apos;,&apos;Y&apos;)</expression>
    </formulas>
    <formulas>
        <description>Remove comma from the value</description>
        <name>formAnnualRevenueText</name>
        <dataType>String</dataType>
        <expression> SUBSTITUTE(TEXT({!varOpp.Annual_Revenue__c}), &quot;,&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>Converts Date to YYYY-MM-DD format</description>
        <name>formAppDate</name>
        <dataType>String</dataType>
        <expression>IF (!ISBLANK ({!varOpp.Application_Submitted__c})
, 
RIGHT(&apos;0&apos; &amp; TEXT(MONTH (DATEVALUE({!varOpp.Application_Submitted__c}))),2) &amp; &apos;/&apos; &amp; RIGHT (&apos;0&apos; &amp; TEXT(DAY (DATEVALUE({!varOpp.Application_Submitted__c}))),2) 
&amp; &apos;/&apos; &amp; TEXT(YEAR (DATEVALUE({!varOpp.Application_Submitted__c})))
, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>formatAverageDeposits</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(TEXT({!Get_Financial.Average_Deposits__c}), &apos;,&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>formatAverageEndingBalance</name>
        <dataType>String</dataType>
