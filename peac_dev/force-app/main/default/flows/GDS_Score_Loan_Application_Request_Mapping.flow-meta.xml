    </formulas>
    <formulas>
        <name>formatAverageNSF</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(TEXT({!Get_Financial.Average_NSFs__c}), &apos;,&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>formatAverageNumDeposit</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(TEXT({!Get_Financial.Average_Number_of_Deposits__c}), &apos;,&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>formatAverageOpeningBalance</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(TEXT({!Get_Financial.Average_Opening_Balance__c}), &apos;,&apos;, &apos;&apos;)</expression>
