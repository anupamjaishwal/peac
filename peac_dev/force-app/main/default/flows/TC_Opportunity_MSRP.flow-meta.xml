    <description>Performs logic based on the opportunity&apos;s MSRP</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>TODAY() + 1</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_2_myRule_1_A2_9372281776</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>NOT(ISNULL([Opportunity].MSRP__c )) &amp;&amp; 
ISCHANGED([Opportunity].MSRP__c) &amp;&amp; ([Opportunity].Total_Asset_Cost_Sum_from_Assets__c &gt;= (1.3 * [Opportunity].MSRP__c)) 

&amp;&amp; 

(CASE([Opportunity].StageName,
&apos;Proposal&apos;,1,
&apos;Docs Requested&apos;,1,
&apos;Docs Out&apos;,1,
&apos;Docs In&apos;,1,
0) = 1)

&amp;&amp; (CASE([Opportunity].Branch__c,
&apos;OEG/NATIONAL&apos;,1,
&apos;OEG - Major Accounts&apos;,1,
&apos;Office Equip Group-OEG&apos;,1,
0) = 1)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISNULL({!myVariable_current.MSRP__c} )) &amp;&amp; 
ISCHANGED({!myVariable_current.MSRP__c}) &amp;&amp; ({!myVariable_current.Total_Asset_Cost_Sum_from_Assets__c} &gt;= (1.3 * {!myVariable_current.MSRP__c})) 

&amp;&amp; 

(CASE({!myVariable_current.StageName},
&apos;Proposal&apos;,1,
&apos;Docs Requested&apos;,1,
&apos;Docs Out&apos;,1,
&apos;Docs In&apos;,1,
0) = 1)

&amp;&amp; (CASE({!myVariable_current.Branch__c},
&apos;OEG/NATIONAL&apos;,1,
&apos;OEG - Major Accounts&apos;,1,
&apos;Office Equip Group-OEG&apos;,1,
0) = 1)</expression>
    </formulas>
