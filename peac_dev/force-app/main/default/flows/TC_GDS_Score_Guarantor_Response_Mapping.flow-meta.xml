            </value>
        </assignmentItems>
    </assignments>
    <formulas>
        <name>formCRAJudgments</name>
        <dataType>Currency</dataType>
        <expression>IF (ISBLANK({!varPGResp.Lexis_Nexis_Total_CRA_Lien_Judgments__c}),NULL,VALUE({!varPGResp.Lexis_Nexis_Total_CRA_Lien_Judgments__c}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formPGUtilization</name>
        <dataType>Number</dataType>
        <expression>IF (ISBLANK ({!varPGResp.PG_Utilization__c}), NULL, VALUE({!varPGResp.PG_Utilization__c}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formVantage</name>
        <dataType>Number</dataType>
        <expression>IF (ISBLANK({!varPGResp.Vantage__c}),NULL,VALUE({!varPGResp.Vantage__c}))</expression>
        <scale>0</scale>
    </formulas>
