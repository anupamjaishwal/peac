    <description>TC Account - Trigger Dealer GDS</description>
    <formulas>
        <name>iGDSDealer</name>
        <dataType>Boolean</dataType>
        <expression>AND(
   OR(
       ISCHANGED({!$Record.DM_Review_Status__c}),
       ISCHANGED({!$Record.Review_For__c})
   ),
   CONTAINS({!$Record.RecordType.Name}, &apos;Dealer&apos;),
   ISPICKVAL({!$Record.DM_Review_Status__c}, &apos;Submitted for Review&apos;),
   OR(
         INCLUDES({!$Record.Review_For__c},&apos;Approval&apos;),
         INCLUDES({!$Record.Review_For__c},&apos;Predelivery&apos;)
   )
)</expression>
    </formulas>
    <formulas>
        <name>iGDSDealerHasDealer</name>
        <dataType>String</dataType>
        <expression>{!$Label.TC_GDS_Get_Dealer}</expression>
    </formulas>
    <formulas>
        <name>ihasDealerNumber</name>
        <dataType>Boolean</dataType>
        <expression>AND(
   OR(
       ISCHANGED({!$Record.DM_Review_Status__c}),
       ISCHANGED({!$Record.Review_For__c})
   ),
   CONTAINS({!$Record.RecordType.Name}, &apos;Dealer&apos;),
   ISPICKVAL({!$Record.DM_Review_Status__c}, &apos;Submitted for Review&apos;),
   OR(
         INCLUDES({!$Record.Review_For__c},&apos;Approval&apos;),
         INCLUDES({!$Record.Review_For__c},&apos;Predelivery&apos;)
   ),
   NOT(ISBLANK({!$Record.Dealer_Number__c}))
)</expression>
    </formulas>
    <formulas>
        <name>iLabel</name>
        <dataType>String</dataType>
        <expression>{!$Label.TC_GDS_Get_Dealer_InfoLease}</expression>
    </formulas>
    <formulas>
        <name>iNoDealerNumber</name>
        <dataType>Boolean</dataType>
        <expression>AND(
   OR(
       ISCHANGED({!$Record.DM_Review_Status__c}),
       ISCHANGED({!$Record.Review_For__c})
   ),
   CONTAINS({!$Record.RecordType.Name}, &apos;Dealer&apos;),
   ISPICKVAL({!$Record.DM_Review_Status__c}, &apos;Submitted for Review&apos;),
   OR(
         INCLUDES({!$Record.Review_For__c},&apos;Approval&apos;),
         INCLUDES({!$Record.Review_For__c},&apos;Predelivery&apos;)
   ),
   ISBLANK({!$Record.Dealer_Number__c})
)</expression>
    </formulas>
