    <description>DP-1222 moved the group assignment to SL_UserTriggerHandler
DP-1089 First check if the permission set has already been assigned.
Adds User to Public Group and Assigns permission set &quot;Dealer Admin&quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>AllPermissionSetName</name>
        <dataType>String</dataType>
        <expression>{!var_OriginalString}+&apos;,&apos;+{!Get_User_PermissionSet_Assignment.Specific_Role_Permission_Set__c}</expression>
    </formulas>
    <formulas>
        <name>IsPartnerExecutive</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!$Record.UserRole.Name}, &apos;Partner Executive&apos;)</expression>
    </formulas>
    <formulas>
        <description>Split value</description>
        <name>varF_Display_split</name>
        <dataType>String</dataType>
        <expression>LEFT( {!var_OriginalString}, FIND(&apos;,&apos;,  {!var_OriginalString})-1)</expression>
    </formulas>
    <formulas>
        <description>Remove first string from whole string</description>
        <name>varF_Display_substitute</name>
        <dataType>String</dataType>
        <expression>RIGHT({!var_OriginalString},LEN({!var_OriginalString})-FIND(&apos;,&apos;,  {!var_OriginalString}))</expression>
    </formulas>
    <formulas>
        <name>varF_Occurrences_of_comma_max</name>
        <dataType>Number</dataType>
        <expression>(LEN({!var_OriginalString})-LEN(SUBSTITUTE(LOWER({!var_OriginalString}), &quot;,&quot;, &quot;&quot;)))</expression>
        <scale>0</scale>
    </formulas>
