    <environments>Default</environments>
    <formulas>
        <name>endingpayment</name>
        <dataType>Boolean</dataType>
        <expression>OR(
AND(
   ISNEW(),
   !ISBLANK({!$Record.of_ending_payments__c}),
   !ISBLANK({!$Record.Payment_Amount__c})
),
AND(
   !ISNEW(),
   !ISBLANK({!$Record.of_ending_payments__c}),
   !ISBLANK({!$Record.Payment_Amount__c}),
   OR(
      ISCHANGED({!$Record.of_ending_payments__c}),
      ISCHANGED({!$Record.Payment_Amount__c})
    )
)
)</expression>
    </formulas>
    <formulas>
        <name>EndingPaymentAdvance</name>
        <dataType>Currency</dataType>
        <expression>0</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>EndingpaymentsCal</name>
        <dataType>Number</dataType>
        <expression>{!$Record.of_ending_payments__c}*{!$Record.Payment_Amount__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>SecurityDeposit</name>
        <dataType>Number</dataType>
        <expression>IF(ISNULL({!$Record.Payment_Amount__c}) || ISNULL({!$Record.Sec_Dep_Pymts__c}), 0, {!$Record.Payment_Amount__c} * {!$Record.Sec_Dep_Pymts__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>yearinbusiness</name>
        <dataType>Number</dataType>
        <expression>ROUND((TODAY() - {!$Record.Account.Date_Established__c})/365,0)</expression>
        <scale>0</scale>
    </formulas>
