    <formulas>
        <name>Lendingtree</name>
        <dataType>Boolean</dataType>
        <expression>IF(!CONTAINS({!$Record.Owner.Profile.Name}, &apos;Express&apos;)
&amp;&amp;(ISNEW()||ISCHANGED({!$Record.Product__c})||ISCHANGED({!$Record.Primary_Source__c}))
&amp;&amp;!ISPICKVAL({!$Record.Primary_Source__c}, &apos;LendingTree&apos;),
   True,
   False)</expression>
    </formulas>
    <formulas>
        <name>NotExpress</name>
        <dataType>Boolean</dataType>
        <expression>IF(!CONTAINS({!$Record.Owner.Profile.Name}, &apos;Express&apos;)
&amp;&amp;(ISNEW()||ISCHANGED({!$Record.Product__c})||ISCHANGED({!$Record.Primary_Source__c}))
&amp;&amp;ISPICKVAL({!$Record.Primary_Source__c}, &apos;LendingTree&apos;),
   True,
   False)</expression>
    </formulas>
    <formulas>
        <name>Orgination2</name>
        <dataType>Number</dataType>
        <expression>IF(IsNew() || ISPICKVAL({!$Record.Product__c}, &quot;Concurrent Loan&quot;), 2.0, IF(CONTAINS(TEXT({!$Record.Product__c}), &quot;Renewal&quot;), 1.0, {!$Record.Origination_Fee__c}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Origination1</name>
        <dataType>Number</dataType>
        <expression>CASE(TEXT({!$Record.Product__c}), &quot;Concurrent Loan&quot;,2,&quot;Concurrent&quot;, 2, &quot;New&quot;, 2, &quot;Loan&quot;, 2,&quot;Renewal Loan&quot;,1, &quot;Renewal&quot; , 1, &quot;Renewal Loan-2&quot;, 1,&quot;Renewal Loan-3&quot;,1, &quot;Renewal Loan-4&quot;,1,&quot;Renewal Loan-5&quot;,1,{!$Record.Origination_Fee__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Origination3</name>
        <dataType>Number</dataType>
        <expression>IF(IsNew() || ISPICKVAL({!$Record.Product__c}, &quot;Concurrent Loan&quot;) || ISCHANGED({!$Record.Primary_Source__c}) , 2.5, IF(IsNew() || CONTAINS(TEXT({!$Record.Product__c}), &quot;Renewal&quot;), 1, {!$Record.Origination_Fee__c}))</expression>
        <scale>2</scale>
    </formulas>
