        <expression>AND(
ISBLANK(PRIORVALUE({!$Record.Assigned_Credit_User__c})),
NOT(ISBLANK({!$Record.Assigned_Credit_User__c})),
NOT(ISPICKVAL({!$Record.Opportunity_Status__c}, &quot;Fraud Review&quot;)),
NOT(CONTAINS($Label.PEAC_By_Pass_Credit_Review,$User.Username))  
)</expression>
    </formulas>
