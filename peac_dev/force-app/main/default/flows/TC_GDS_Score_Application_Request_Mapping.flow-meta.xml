    <formulas>
        <description>Converts Date to YYYY-MM-DD format</description>
        <name>formAppDate</name>
        <dataType>String</dataType>
        <expression>IF (!ISBLANK ({!varOpp.Application_Submitted__c})
, TEXT(YEAR (DATEVALUE({!varOpp.Application_Submitted__c}))) &amp; &apos;-&apos; &amp; RIGHT(&apos;0&apos; &amp; TEXT(MONTH (DATEVALUE({!varOpp.Application_Submitted__c}))),2) &amp; &apos;-&apos; &amp; RIGHT (&apos;0&apos; &amp; TEXT(DAY (DATEVALUE({!varOpp.Application_Submitted__c}))),2)
, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>formAutoMoreInfo</name>
        <dataType>String</dataType>
        <expression>IF ({!varOpp.Auto_More_Info_Override__c}, &apos;1&apos;,&apos;0&apos;)</expression>
    </formulas>
    <formulas>
        <name>formBusinessType</name>
        <dataType>String</dataType>
        <expression>CASE({!varAcc.Business_Type__c},
&apos;Proprietorship&apos;, &apos;01&apos;,
&apos;Partnership&apos;, &apos;02&apos;,
&apos;Corporation&apos;, &apos;03&apos;,
&apos;Limited Liability&apos;, &apos;04&apos;,
&apos;Municipal&apos;, &apos;05&apos;,
&apos;Student&apos;, &apos;06&apos;,
&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>formContractTerm</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK ({!varOpp.Terms__c}), &apos;&apos;,TEXT({!varOpp.Terms__c}))</expression>
    </formulas>
    <formulas>
        <name>formCUSTASSETADDRMATCH</name>
        <dataType>Number</dataType>
        <expression>IF ({!varOpp.Account_Business_City__c} == {!Query_Asset_Field.Equipment_City__c}&amp;&amp; {!varOpp.Account_Business_Street__c} == {!Query_Asset_Field.Equipment_Street__c} &amp;&amp; {!varOpp.Account_Business_State_Province__c} == TEXT({!Query_Asset_Field.Equipment_State__c}) &amp;&amp; {!varOpp.Account_Business_Zip_Postal_Code__c} == {!Query_Asset_Field.Equipment_Zip__c},1,0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formDelinOver90</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK({!varAcc.Account_121__c}),&apos;0&apos;,TEXT({!varAcc.Account_121__c}))</expression>
    </formulas>
    <formulas>
        <name>formLoanAmount</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK({!varOpp.Approved_Amount__c}), IF (ISBLANK ({!varOpp.Equipment_Cost__c}), &apos;&apos;,TEXT(FLOOR({!varOpp.Equipment_Cost__c}))), TEXT(FLOOR({!varOpp.Approved_Amount__c})))</expression>
    </formulas>
    <formulas>
        <name>formPaymentFreq</name>
        <dataType>String</dataType>
        <expression>CASE({!varOpp.Payment_Frequency__c}
, &apos;Monthly&apos;, &apos;M&apos;
, &apos;Quarterly&apos;, &apos;Q&apos;
, &apos;Annually&apos;, &apos;A&apos;
, &apos;Variable&apos;, &apos;V&apos;
,&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>formPQExpiration</name>
        <dataType>String</dataType>
        <expression>IF (!ISBLANK ({!varAcc.PQ_Expiration__c})
  , TEXT(YEAR ({!varAcc.PQ_Expiration__c})) &amp; &apos;-&apos; &amp; TEXT(MONTH (({!varAcc.PQ_Expiration__c}))) &amp; &apos;-&apos; &amp; TEXT(DAY ({!varAcc.PQ_Expiration__c}))
  , &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>formSFPModel</name>
        <dataType>String</dataType>
        <expression>IF ({!varOpp.SFP_Model__c}, &apos;1&apos;,&apos;0&apos;)</expression>
    </formulas>
    <formulas>
        <name>formTibOverride</name>
        <dataType>Number</dataType>
        <expression>IF({!varOpp.TIB_Override__c}, 1, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formUdCustomerFraudInd</name>
        <dataType>String</dataType>
        <expression>IF ({!varAcc.Fraud_Flag__c}, &apos;1&apos;,&apos;0&apos;)</expression>
    </formulas>
    <formulas>
        <name>formUdMonthsVerified</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK ({!varOpp.Months_Verified__c}) ,&apos;&apos;,TEXT({!varOpp.Months_Verified__c}))</expression>
    </formulas>
    <formulas>
        <name>formUdOfacHit</name>
        <dataType>String</dataType>
        <expression>IF ({!varOpp.OFAC_HIT__c} == &apos;&apos;, &apos;NO&apos;,{!varOpp.OFAC_HIT__c})</expression>
    </formulas>
    <formulas>
        <name>formVendorApproval</name>
        <dataType>String</dataType>
        <expression>IF ({!varAcc.Vendor_Approval__c}, &apos;1&apos;,&apos;0&apos;)</expression>
    </formulas>
    <formulas>
        <description>Used for SAL-2732</description>
        <name>OpportunityRecordType</name>
        <dataType>String</dataType>
        <expression>TRIM(LEFT({!varOpp.record_type_name__c}, FIND(&quot; &quot;, {!varOpp.record_type_name__c})))</expression>
    </formulas>
