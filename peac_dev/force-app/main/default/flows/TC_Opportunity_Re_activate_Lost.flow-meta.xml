    <decisions>
        <name>Is_Stage_Lost</name>
        <label>Is Stage Lost?</label>
        <locationX>358</locationX>
        <locationY>497</locationY>
        <defaultConnector>
            <targetReference>Stage_is_Not_Lost_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Stage is Not Lost</defaultConnectorLabel>
        <rules>
            <name>Stage_is_Lost</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Running_User</targetReference>
            </connector>
            <label>Stage is Lost</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_User_a_Channel_Approver</name>
        <label>Is User a Channel Approver?</label>
        <locationX>754</locationX>
        <locationY>286</locationY>
        <defaultConnector>
            <targetReference>User_is_Not_Channel_Approver_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>User is Not Channel Approver</defaultConnectorLabel>
        <rules>
            <name>User_is_Channel_Approver</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Running_User.Doc_Fee_Exception_Approver__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Opportunity_Stage</targetReference>
            </connector>
            <label>User is Channel Approver</label>
        </rules>
    </decisions>
