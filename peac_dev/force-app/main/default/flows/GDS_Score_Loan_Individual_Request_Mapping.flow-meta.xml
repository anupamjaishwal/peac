    <description>This flow is used for map Guarantor and contacts object fields into Gds_Score_Request_Individual__c object record while making gds callout.</description>
    <environments>Default</environments>
    <formulas>
        <name>formatOwnershipPer</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(LEFT(TRIM(TEXT({!varCon.Ownership_Pct__c}*100)), 3), &apos;.&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>FormattedContactPhone</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
  SUBSTITUTE(
    SUBSTITUTE(
      SUBSTITUTE(
        SUBSTITUTE(
          SUBSTITUTE(
            SUBSTITUTE(
              SUBSTITUTE(
                SUBSTITUTE(
                  SUBSTITUTE(
                    {!varCon.Phone},
                    &quot; &quot;, &quot;&quot;
                  ),
                  &quot;-&quot;, &quot;&quot;
                ),
                &quot;(&quot;, &quot;&quot;
              ),
              &quot;)&quot;, &quot;&quot;
            ),
            &quot;.&quot;, &quot;&quot;
          ),
          &quot;+&quot;, &quot;&quot;
        ),
        &quot;/&quot;, &quot;&quot;
      ),
      &quot;*&quot;, &quot;&quot;
    ),
    &quot;#&quot;, &quot;&quot;
  ),
  &quot;_&quot;, &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>FormattedHomeZipPostalCode</name>
        <dataType>String</dataType>
        <expression>LEFT(TRIM({!varCon.OtherPostalCode}), 5)</expression>
    </formulas>
    <formulas>
        <name>FormattedMailingZipPostalCode</name>
        <dataType>String</dataType>
        <expression>LEFT(TRIM({!varCon.MailingPostalCode}), 5)</expression>
    </formulas>
    <formulas>
        <name>formBirthdate</name>
        <dataType>String</dataType>
        <expression>IF(!ISBLANK({!varCon.Birthdate}),RIGHT(&apos;0&apos; &amp; TEXT(MONTH({!varCon.Birthdate})), 2) &amp; &apos;/&apos; &amp; RIGHT(&apos;0&apos; &amp; TEXT(DAY({!varCon.Birthdate})), 2) &amp; &apos;/&apos; &amp; TEXT(YEAR({!varCon.Birthdate})),&apos;&apos;)</expression>
    </formulas>
