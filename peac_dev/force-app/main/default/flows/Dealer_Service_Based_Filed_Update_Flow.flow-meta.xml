    <description>Dealer Service Based Filed Update - Update Dealer Service based | PG 12/02/2021 - V2 - Fix the condition for Service based</description>
    <formulas>
        <name>iNonServiceBased</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!$Record.Equipment_Type__c})),
NOT(INCLUDES({!$Record.Equipment_Type__c},&quot;GPS Unit&quot;)),
NOT(INCLUDES({!$Record.Equipment_Type__c},&quot;Computer Hardware(Gen)&quot;)),
NOT(INCLUDES({!$Record.Equipment_Type__c},&quot;Computer Software (Gen)&quot;)),
NOT(INCLUDES({!$Record.Equipment_Type__c},&quot;POS/Point of Sale&quot;)),
NOT(INCLUDES({!$Record.Equipment_Type__c},&quot;CCTV Security System&quot;)),
NOT(INCLUDES({!$Record.Equipment_Type__c},&quot;Telecom (General)&quot;)),
NOT(INCLUDES({!$Record.Equipment_Type__c},&quot;VOIP&quot;)))</expression>
    </formulas>
    <formulas>
        <name>iServiceBased</name>
        <dataType>Boolean</dataType>
        <expression>!ISBLANK({!$Record.Equipment_Type__c}) &amp;&amp; (INCLUDES({!$Record.Equipment_Type__c},&quot;GPS Unit&quot;) ||INCLUDES({!$Record.Equipment_Type__c},&quot;Computer Hardware(Gen)&quot;) ||INCLUDES({!$Record.Equipment_Type__c},&quot;Computer Software (Gen)&quot;) || INCLUDES({!$Record.Equipment_Type__c},&quot;POS/Point of Sale&quot;) || INCLUDES({!$Record.Equipment_Type__c},&quot;Security Systems (general)&quot;) || INCLUDES({!$Record.Equipment_Type__c},&quot;CCTV Security System&quot;)|| INCLUDES({!$Record.Equipment_Type__c},&quot;Telecom (General)&quot;)||INCLUDES({!$Record.Equipment_Type__c},&quot;VOIP&quot;))</expression>
    </formulas>
