                <formulaExpression>{!Advance_Payments} &gt;= 0</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>BuyDown</name>
            <dataType>Currency</dataType>
            <fieldText>Buy Down</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
