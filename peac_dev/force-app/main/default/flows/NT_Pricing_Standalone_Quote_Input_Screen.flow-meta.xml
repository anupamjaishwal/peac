        <fields>
            <name>Down_Payment</name>
            <dataType>Currency</dataType>
            <fieldText>Down Payment</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
            <validationRule>
                <errorMessage>&lt;p&gt;&lt;span style=&quot;font-size: 14px; font-family: sans-serif; color: rgb(255, 0, 0);&quot;&gt;Down Payment must be greater than or equal to 0 and cannot exceed Financed Amount&lt;/span&gt;&lt;/p&gt;</errorMessage>
                <formulaExpression>({!Down_Payment} &gt;= 0) &amp;&amp; (ISNULL({!Financed_Amount}) || {!Down_Payment} &lt;= {!Financed_Amount})</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Financed_Amount</name>
            <dataType>Currency</dataType>
            <fieldText>Financed Amount</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Enter either Financed Amount OR Requested Payment Amount.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The system will automatically calculate the other based on your entry.&lt;/p&gt;</helpText>
            <isDisabled>
                <elementReference>RequestedPaymentAmountEntered</elementReference>
            </isDisabled>
            <isRequired>false</isRequired>
            <scale>2</scale>
            <validationRule>
                <errorMessage>&lt;p&gt;&lt;span style=&quot;font-family: sans-serif; font-size: 14px; color: rgb(255, 0, 0);&quot;&gt;One of Financed Amount or Requested Payment Amount must be supplied&lt;/span&gt;&lt;/p&gt;</errorMessage>
                <formulaExpression>NOT(ISBLANK({!Financed_Amount}))</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Requested_Payment_Amount</name>
            <dataType>Currency</dataType>
            <fieldText>Requested Payment Amount</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Enter either Requested Payment Amount OR Financed Amount. &lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The system will automatically calculate the other based on your entry.&lt;/p&gt;</helpText>
            <isDisabled>
                <elementReference>FinancedAmountEntered</elementReference>
            </isDisabled>
            <isRequired>false</isRequired>
            <scale>2</scale>
            <validationRule>
                <errorMessage>&lt;p&gt;&lt;span style=&quot;font-family: sans-serif; font-size: 14px; background-color: rgb(255, 255, 255); color: rgb(255, 0, 0);&quot;&gt;One of Financed Amount or Requested Payment Amount must be supplied&lt;/span&gt;&lt;/p&gt;</errorMessage>
                <formulaExpression>NOT(ISBLANK({!Requested_Payment_Amount}))</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>End_of_Term_Option</name>
            <choiceReferences>EndOfTermOption</choiceReferences>
            <dataType>String</dataType>
            <fieldText>End-of-Term Option</fieldText>
            <fieldType>DropdownBox</fieldType>
