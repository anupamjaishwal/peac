    <formulas>
        <name>FinancedAmountEntered</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Financed_Amount}))</expression>
    </formulas>
    <formulas>
        <name>quoteNameText</name>
        <dataType>String</dataType>
        <expression>&quot;QUOTE-&quot; &amp; 
LEFT(&quot;0000&quot;, 4 - LEN(TEXT({!counterNumber} + 1))) &amp; 
TEXT({!counterNumber} + 1)</expression>
    </formulas>
    <formulas>
        <name>RequestedPaymentAmountEntered</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Requested_Payment_Amount}))</expression>
    </formulas>
    <formulas>
        <name>varFinalDealerIdFormula</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!varSelectedDealerId}),
  {!varDealerAccountId},
  {!varSelectedDealerId}
)</expression>
    </formulas>
