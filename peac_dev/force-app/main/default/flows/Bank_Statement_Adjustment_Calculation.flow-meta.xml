<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <assignments>
        <name>Set_Revised_Daily_Average_Balance</name>
        <label>Set Revised Daily Average Balance</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Daily_Average_Balance__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varFormulaRevisedDailyAverageBalance</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Amount_of_Deposits__c</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varFormulaAdjustmentTotal</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Ability for user to make &apos;Adjustment&apos; to the bank statement &apos;Deposit Amount’. SAL-5517</description>
    <environments>Default</environments>
    <formulas>
        <name>AdjustmentAddition</name>
        <dataType>Currency</dataType>
        <expression>IF( ISBLANK({!$Record.Total_Adjustment_Addition__c}) , 0, {!$Record.Total_Adjustment_Addition__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>AdjustmentDeduction</name>
        <dataType>Currency</dataType>
        <expression>IF( ISBLANK({!$Record.Total_Adjustment_Deduction__c}), 0,  {!$Record.Total_Adjustment_Deduction__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varFormulaAdjustmentTotal</name>
        <dataType>Currency</dataType>
        <expression>{!AdjustmentAddition}-{!AdjustmentDeduction}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>varFormulaRevisedDailyAverageBalance</name>
        <dataType>Currency</dataType>
        <expression>( ({!$Record.Amount_of_Deposits__c} + {!varFormulaAdjustmentTotal}) / {!$Record.Amount_of_Deposits__c} ) *{!$Record.Daily_Average_Balance__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Adjustment Calculation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Bank Statement Adjustment Calculation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Revised_Daily_Average_Balance</targetReference>
        </connector>
        <filterLogic>1 OR 2</filterLogic>
        <filters>
            <field>Total_Adjustment_Addition__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Total_Adjustment_Deduction__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Bank_Statement__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
