        <name>myRule_1_A1</name>
        <label>Update Equipment Address</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Equipment_State__c</field>
            <value>
                <elementReference>$Record.Opportunity__r.Account_Business_State_Province__c</elementReference>
            </value>
        </inputAssignments>
