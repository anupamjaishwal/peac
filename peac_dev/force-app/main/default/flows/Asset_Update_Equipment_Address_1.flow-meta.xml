    <description>Migrated from the Asset: Update Equipment Address process using Use Opp. Billing Address? criteria.
Update equipment address if to ship to address on opportunity</description>
    <label>Asset: Update Equipment Address_1</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
