    <formulas>
        <name>defaultPointsWhenOptional</name>
        <dataType>Number</dataType>
        <expression>IF(ISPICKVAL({!theOpportunity.Dealer_Account__r.Point_Tier__c}, &apos;Optional&apos;), {!theOpportunity.Points__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>pointsForHousePlus</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!Points}), 0, {!Points}) + VALUE(IF(ISBLANK(TEXT({!theOpportunity.Dealer_Account__r.Points__c})), &apos;0&apos;, TEXT({!theOpportunity.Dealer_Account__r.Points__c})))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>pointsForOptional</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!Points}), {!theOpportunity.Points__c}, {!Points})</expression>
        <scale>2</scale>
    </formulas>
