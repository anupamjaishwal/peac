    <environments>Default</environments>
    <formulas>
        <name>DisburseAmountCal</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Loan_Amount__c} - (IF(!ISBLANK({!$Record.Origination_Amount__c}), {!$Record.Origination_Amount__c}, 0)) - (IF(!ISBLANK({!$Record.Renewal_Payoff_Amount__c}), {!$Record.Renewal_Payoff_Amount__c}, 0)) - (IF(!ISBLANK({!$Record.Competitor_Payoff_Amount__c}), {!$Record.Competitor_Payoff_Amount__c}, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DisbursementAmountcal</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Loan_Amount__c} - (IF(!ISBLANK({!$Record.Origination_Amount__c}), {!$Record.Origination_Amount__c}, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>LoanAmountMax</name>
        <dataType>Boolean</dataType>
        <expression>OR(
   AND(
      ISNEW(),
     !ISBLANK({!$Record.Loan_Amount__c}),
     !ISBLANK({!$Record.Max_Rate__c}),
     {!$Record.Loan_Amount__c} &gt; 0,
     {!$Record.Loan_Record_Type__c} = TRUE
   ),
   AND(
     !ISBLANK({!$Record.Loan_Amount__c}),
     !ISBLANK({!$Record.Max_Rate__c}),
     {!$Record.Loan_Amount__c} &gt; 0,
     {!$Record.Loan_Record_Type__c} = TRUE,
     OR(
        ISCHANGED({!$Record.Loan_Amount__c}),
        ISCHANGED({!$Record.Max_Rate__c}),
        ISBLANK({!$Record.Repayment_Amount__c})
     )
   )
)</expression>
    </formulas>
    <formulas>
        <name>RecalcDisbursement</name>
        <dataType>Boolean</dataType>
        <expression>OR(
   AND(
      ISNEW(),
     !ISBLANK({!$Record.Loan_Amount__c}),
     !ISBLANK({!$Record.Origination_Amount__c}),
     !ISBLANK({!$Record.Renewal_Payoff_Amount__c}), 
     {!$Record.Loan_Amount__c} &gt; 0,
     {!$Record.Loan_Record_Type__c} = TRUE
   ),
   AND(
     !ISBLANK({!$Record.Loan_Amount__c}),
     {!$Record.Loan_Amount__c} &gt; 0,
     {!$Record.Loan_Record_Type__c} = TRUE,
     OR(
        ISCHANGED({!$Record.Loan_Amount__c}),
        ISCHANGED({!$Record.Competitor_Payoff_Amount__c}),
        ISCHANGED({!$Record.Renewal_Payoff_Amount__c}),
        ISCHANGED({!$Record.Origination_Amount__c}),
        ISBLANK({!$Record.Disbursement_Amount__c}) 
     )
   )
)</expression>
    </formulas>
    <formulas>
        <name>RepaymentAmountCal</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Loan_Amount__c} * {!$Record.Max_Rate__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>reviewforBooking</name>
        <dataType>Boolean</dataType>
        <expression>AND(CASE({!$Record.StageName},
   &quot;Review for Booking&quot;, 1, 
   &quot;Funding&quot;,1,
   &quot;Booking&quot;,1,
   &quot;Booking (Loan)&quot;,1,
   &quot;Funding (Loan)&quot;,1,
   &quot;Funded/Booked&quot;,1,
   &quot;Lost&quot;,1,0)=1,
 OR(
   AND(
      ISNEW(),
     !ISBLANK({!$Record.Loan_Amount__c}),
     !ISBLANK({!$Record.Origination_Amount__c}),
     !ISBLANK({!$Record.Renewal_Payoff_Amount__c}), 
     {!$Record.Loan_Amount__c} &gt; 0,
     {!$Record.Loan_Record_Type__c} = TRUE
   ),
   AND(
     !ISBLANK({!$Record.Loan_Amount__c}),
     {!$Record.Loan_Amount__c} &gt; 0,
     {!$Record.Loan_Record_Type__c} = TRUE,
     OR(
        ISCHANGED({!$Record.StageName}),
        ISCHANGED({!$Record.Loan_Amount__c}),
        ISCHANGED({!$Record.Competitor_Payoff_Amount__c}),
        ISCHANGED({!$Record.Renewal_Payoff_Amount__c}),
        ISCHANGED({!$Record.Origination_Amount__c}),
        ISBLANK({!$Record.Disbursement_Amount__c}) 
     )
   )
 )
)</expression>
    </formulas>
    <formulas>
        <name>StageName</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.StageName},   &quot;Review for Booking&quot;, &quot;1&quot;, 
   &quot;Funding&quot;,&quot;1&quot;,
   &quot;Booking&quot;,&quot;1&quot;,
   &quot;Booking (Loan)&quot;,&quot;1&quot;,
   &quot;Funding (Loan)&quot;,&quot;1&quot;,
   &quot;Funded/Booked&quot;,&quot;1&quot;,
   &quot;Lost&quot;,&quot;1&quot;,&quot;0&quot;)</expression>
    </formulas>
