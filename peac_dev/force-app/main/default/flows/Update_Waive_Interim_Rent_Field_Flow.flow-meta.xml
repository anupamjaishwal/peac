                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Variable_Payment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Required_Adv_Payments__c</leftValueReference>
                <operator>IsNull</operator>
