    <decisions>
        <description>only send emails if the current user is partner user</description>
        <name>is_DP_User</name>
        <label>is DP User</label>
        <locationX>776</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>yes_send_emails</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_current_user.IsPortalEnabled</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GETOpportunity</targetReference>
            </connector>
            <label>yes, send emails</label>
        </rules>
    </decisions>
