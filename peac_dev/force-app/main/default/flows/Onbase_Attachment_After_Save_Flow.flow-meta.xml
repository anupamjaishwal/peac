    <decisions>
        <name>Check_if_Ambassador_Email_is_NullCheck_Who_Will_Receive_the_Email</name>
        <label>Check if Ambassador Email is NullCheck Who Will Receive the Email</label>
        <locationX>446</locationX>
        <locationY>1163</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_Ambassador_Email_is_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Dealer_Account__r.Ambassador__r.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Ambassador_Email_to_Variable</targetReference>
            </connector>
            <label>Check if Ambassador Email is Null</label>
        </rules>
        <rules>
            <name>Check_if_the_CMS_User_email_on_Opportunity_is_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Assign_To_CMS_User__r.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CMS_Email_to_Variable</targetReference>
            </connector>
            <label>Check if the CMS User email on Opportunity is Null</label>
        </rules>
        <rules>
            <name>If_Both_Emails_are_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Dealer_Account__r.Ambassador__r.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__r.Assign_To_CMS_User__r.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_PortalDocs_peacsolutions_com</targetReference>
            </connector>
            <label>If Both Emails are Null</label>
        </rules>
    </decisions>
