<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>AddRecordType</name>
        <label>Add Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_RecordTypeList</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>End User Account</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_RecordTypeList</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Dealer Account</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>GET_Duplicate_Accounts</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>CheckAccounts</name>
        <label>Check Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IfAccountsispresent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GET_Duplicate_Accounts</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Record_Type_Custom_Formula__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>GET_Duplicate_Accounts.Account_Record_Type_Custom_Formula__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DuplicateErrorMessageForTaxId</targetReference>
            </connector>
            <label>If Accounts is present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Exclude_Profiles</name>
        <label>Exclude Profiles</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>AddRecordType</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Profiles_Excluded</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DataAdmin</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>User MarlinDocusign</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>System Administrator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Booking</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>GDS</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetDPProfilesMetadata.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Profiles Excluded</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Account Duplicate Rules {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Duplicate Rules</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GET_Duplicate_Accounts</name>
        <label>GET Duplicate Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CheckAccounts</targetReference>
        </connector>
        <filterLogic>1 AND 3 AND 5 AND 2 AND 4</filterLogic>
        <filters>
            <field>Account_Record_Type_Custom_Formula__c</field>
            <operator>In</operator>
            <value>
                <elementReference>var_RecordTypeList</elementReference>
            </value>
        </filters>
        <filters>
            <field>Tax_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Tax_ID__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Account_CurrentUser_Profile__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>DataAdmin</stringValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Tax_ID__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetDPProfilesMetadata</name>
        <label>GetDPProfilesMetadata</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Exclude_Profiles</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Profile_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Profile.Name</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>DP_Profiles__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetDPProfilesMetadata</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_RecordTypeList</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
