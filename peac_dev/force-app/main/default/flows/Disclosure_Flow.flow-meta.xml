    <formulas>
        <name>AverageMonthlyCost</name>
        <dataType>Currency</dataType>
        <expression>IF ({!Get_Opportunity.Variable_Payment__c} , {!TotalVariablePayments}, ({!Get_Opportunity.Payment_Amount__c} * {!Get_Opportunity.Terms__c}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DisclosureThirdPartyPayments</name>
        <dataType>String</dataType>
        <expression>IF( {!PayoffCount}&gt;0 &amp;&amp; {!ThirdPartyCount}&gt;0 , {!ThirdPartyPayments}, &quot;0&quot;)</expression>
    </formulas>
    <formulas>
        <name>PayoffAccountNumberItem</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!PayoffAccountNumber}), {!Payoffs_loop.Name} , &quot;, &quot; &amp;  {!Payoffs_loop.Name} )</expression>
    </formulas>
    <formulas>
        <name>PayoffAmountItem</name>
        <dataType>String</dataType>
        <expression>IF( ISBLANK({!PayoffAmountsList}) ,  &quot;$&quot; &amp; TEXT({!Payoffs_loop.Payoff_Amount__c}),  &quot;, $&quot; &amp; TEXT({!Payoffs_loop.Payoff_Amount__c})  )</expression>
    </formulas>
    <formulas>
