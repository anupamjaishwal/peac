 -->

<aura:component description="tc_dealDealerDataTable">

    <aura:attribute name="partners" type="TC_DatabaseUtil.TC_RecordWrapper[]" access="global" default="[]"/>
    <aura:attribute name="partnerType" type="String" access="global"/>

    <aura:if isTrue="{!v.partnerType == 'broker'}">

        <table class="slds-table slds-table_bordered slds-max-medium-table_stacked-horizontal slds-no-cell-focus slds-table_fixed-layout">
            <thead>
            <tr class="slds-text-title_caps">
                <th scope="col">
                    <div class="slds-truncate"></div>
                </th>
                <th scope="col">
                    <div class="slds-truncate">Company Name</div>
                </th><!--

                <th scope="col">
                    <div class="slds-truncate">Address</div>
                </th>
                <th scope="col">
                    <div class="slds-truncate">City</div>
                </th>
                <th scope="col">
                    <div class="slds-truncate">State</div>
                </th>
                <th scope="col">
                    <div class="slds-truncate">Postal Code</div>
                </th>
                <th scope="col">
                    <div class="slds-truncate">Phone</div>
                </th>-->
            </tr>
            </thead>
            <tbody>
            <aura:iteration var="partner" items="{!v.partners}" indexVar="i">
                <tr>
                    <th scope="row">
                        <div class="slds-truncate">
                            {!i+1}
                        </div>
                    </th>
                    <td>
                        <div class="slds-truncate">
                            <ui:outputText value="{!partner.account.Name}"/>
                            <aura:if isTrue="{!partner.dupe}">
                                <span style="color:red;">&nbsp;(Duplicate Account record found and pulled in)</span>
                            </aura:if>
                        </div>
                    </td><!--
                    <td>
                        <div class="slds-truncate">
                            <ui:outputText value="{!partner.account.Business_Address__c}"/>
                        </div>
                    </td>
                    <td>
                        <div class="slds-truncate">
                            <ui:outputText value="{!partner.account.Business_City__c}"/>
                        </div>
                    </td>
                    <td>
                        <div class="slds-truncate">
                            <ui:outputText value="{!partner.account.Business_State__c}"/>
                        </div>
                    </td>
                    <td>
                        <div class="slds-truncate">
                            <ui:outputText value="{!partner.account.Business_Zip__c}"/>
                        </div>
                    </td>

                    <td>
                        <div class="slds-truncate">
                            <ui:outputPhone value="{!partner.account.Phone}"/>
                        </div>
                    </td>-->

                </tr>
            </aura:iteration>
            </tbody>
        </table>

        <aura:set attribute="else">


            <aura:if isTrue="{!v.partnerType == 'dealer'}">

                <!-- Start Dealer -->
                <table class="slds-table slds-table_bordered slds-max-medium-table_stacked-horizontal slds-no-cell-focus slds-table_fixed-layout">
                    <thead>
                    <tr class="slds-text-title_caps">
                        <th scope="col">
                            <div class="slds-truncate"></div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate">Company Name</div>
                        </th><!--

                        <th scope="col">
                            <div class="slds-truncate">Address</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate">City</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate">State</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate">Postal Code</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate">Phone</div>
                        </th>

                        <th scope="col">
                            <div class="slds-truncate">Dealer #</div>
                        </th-->

                        <th scope="col">
                            <div class="slds-truncate">Contact Name</div>
                        </th>
                        <!--th scope="col">
                            <div class="slds-truncate">Contact Phone</div>
                        </th-->
                    </tr>
                    </thead>
                    <tbody>
                    <aura:iteration var="partner" items="{!v.partners}" indexVar="i">
                        <tr>
                            <th scope="row">
                                <div class="slds-truncate">
                                    {!i+1}
                                </div>
                            </th>
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!partner.account.Name}"/>
                                    <aura:if isTrue="{!partner.dupe}">
                                        <span style="color:red;">&nbsp;(Duplicate Account record found and pulled in)</span>
                                    </aura:if>
                                </div>
                            </td><!--
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!partner.account.Business_Address__c}"/>
                                </div>
                            </td>
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!partner.account.Business_City__c}"/>
                                </div>
                            </td>
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!partner.account.Business_State__c}"/>
                                </div>
                            </td>
                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!partner.account.Business_Zip__c}"/>
                                </div>
                            </td>

                            <td>
                                <div class="slds-truncate">
                                    <ui:outputPhone value="{!partner.account.Phone}"/>
                                </div>
                            </td>

                            <td>
                                <div class="slds-truncate">
                                    <ui:outputPhone value="{!partner.account.Dealer_Number__c}"/>
                                </div>
                            </td>-->

                            <td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!partner.subRecord.contact.FirstName + ' ' + partner.subRecord.contact.LastName}"/>
                                    <aura:if isTrue="{!partner.subRecord.dupe}">
                                        <span style="color:red;">&nbsp;(Duplicate Contact record found and pulled in)</span>
                                    </aura:if>
                                </div>
                            </td>

                            <!--td>
                                <div class="slds-truncate">
                                    <ui:outputText value="{!partner.subRecord.contact.MobilePhone}"/>
                                </div>
                            </td-->

                        </tr>
                    </aura:iteration>
                    </tbody>
                </table>

                <!-- END Dealer -->
                <aura:set attribute="else">
                    <!-- Start Franchisor -->

                    <table class="slds-table slds-table_bordered slds-max-medium-table_stacked-horizontal slds-no-cell-focus slds-table_fixed-layout">
                        <thead>
                        <tr class="slds-text-title_caps">
                            <th scope="col">
                                <div class="slds-truncate"></div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate">Company Name</div>
                            </th><!--

                            <th scope="col">
                                <div class="slds-truncate">Address</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate">City</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate">State</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate">Postal Code</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate">Phone</div>
                            </th>-->


                        </tr>
                        </thead>
                        <tbody>
                        <aura:iteration var="partner" items="{!v.partners}" indexVar="i">
                            <tr>
                                <th scope="row">
                                    <div class="slds-truncate">
                                        {!i+1}
                                    </div>
                                </th>
                                <td>
                                    <div class="slds-truncate">
                                        <ui:outputText value="{!partner.account.Name}"/>
                                        <aura:if isTrue="{!partner.dupe}">
                                            <span style="color:red;">&nbsp;(Duplicate Account record found and pulled in)</span>
                                        </aura:if>
                                    </div>
                                </td><!--
                                <td>
                                    <div class="slds-truncate">
                                        <ui:outputText value="{!partner.account.Business_Address__c}"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="slds-truncate">
                                        <ui:outputText value="{!partner.account.Business_City__c}"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="slds-truncate">
                                        <ui:outputText value="{!partner.account.Business_State__c}"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="slds-truncate">
                                        <ui:outputText value="{!partner.account.Business_Zip__c}"/>
                                    </div>
                                </td>

                                <td>
                                    <div class="slds-truncate">
                                        <ui:outputPhone value="{!partner.account.Phone}"/>
                                    </div>
                                </td>-->

                            </tr>
                        </aura:iteration>
                        </tbody>
                    </table>

                    <!-- End Franchisor -->
                </aura:set>

            </aura:if>




        </aura:set>
    </aura:if>
</aura:component>