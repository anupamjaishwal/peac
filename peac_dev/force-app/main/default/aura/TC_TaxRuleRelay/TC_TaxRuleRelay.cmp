<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader,force:hasSObjectName" access="GLOBAL">
	<lightning:empApi aura:id="empApi"/>
    <aura:handler name="init" value="{!this}" action="{!c.onInit}"/>

    <!-- Holds the streaming event subscription -->
    <aura:attribute name="subscription" type="Map" />
    <!--<lightning:spinner aura:id="spinner" variant="brand" size="large" class="slds-hide"/>-->

    
    
    
    <div aura:id="spinner" class="slds-spinner_container slds-is-fixed slds-hide">
        <div class="slds-spinner--brand  slds-spinner slds-spinner--large" role="alert">
            <span class="slds-assistive-text">Loading</span>
            <div class="slds-spinner__dot-a"></div>
            <div class="slds-spinner__dot-b"></div>
            <div class="custom-loading-text">
                Tax Rules Running.......
            </div>
        </div>
    </div>
</aura:component>