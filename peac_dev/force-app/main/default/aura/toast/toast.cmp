<aura:component >
    <aura:attribute name="type" type="String"/>
    <aura:attribute name="title" type="String"/>
    <aura:attribute name="message" type="String"/>
    <aura:attribute name="mode" type="String"/>
    
    <aura:registerEvent name="toastEvent" type="c:toast_evt"/>
    <aura:handler event="c:toast_evt" action="{!c.handleToast}"/>

    <div class="slds-hide" aura:id="toast">
        <div class="slds-notify_container slds-is-absolute">
            <div class="{!'slds-notify slds-notify_toast slds-theme_' + v.type}" role="alert">
                <span class="slds-assistive-text">{!v.type}</span>
                <span class="{!'slds-icon_container  slds-m-right_small slds-no-flex slds-align-top slds-icon-utility-' + v.type}">
                    <lightning:icon iconName="utility:info" variant="inverse"/>
                </span>
                <div class="slds-notify__content">
                    <h2 class="slds-text-heading_small">{!v.title}</h2>
                    <p>{!v.message}</p>
                </div>
                <button class="slds-button slds-button_icon slds-notify__close slds-button_icon-inverse" title="Close" onclick="{!c.dismiss}">
                    <lightning:icon iconName="utility:close" variant="inverse" size="x-small"/>
                    <span class="slds-assistive-text">Close</span>
                </button>
            </div>
        </div>
    </div>

</aura:component>