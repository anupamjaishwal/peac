<aura:component description="BridgeWare Select Zip Geo Code" controller="TC_BridgewareSelectZipGeoCodeCtrl" 
                implements="force:hasRecordId,force:lightningQuickAction,flexipage:availableForRecordHome">
    
    <aura:attribute name="recordId" type="String" access="global"/>
    <aura:attribute name="taxJurisdiction" type="Object"/>
    <aura:attribute name="taxJurisdictions" type="List"/>
    <aura:attribute name="resultColumns" type="List"/>
    <aura:attribute name="opportunityProbability" type="Decimal"/>
    <aura:attribute name="isLoading" type="Boolean"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <!-- <aura:handler event="force:refreshView" action="{!c.doInit}"/> -->

    <!-- <aura:if isTrue="{!v.taxJurisdiction.zipUpdated}"> -->
        <div class="slds-section slds-is-open">
            <h3 class="slds-section__title">
                <button aria-controls="expand-unique-id" aria-expanded="true" class="slds-button slds-section__title-action">
                    <span class="slds-truncate" title="Tax Jurisdictions">Tax Jurisdictions for Zip Code {!v.taxJurisdiction.zip}</span>
                </button>
            </h3>
            <!--div class="slds-form slds-form_compound">
            <legend class="slds-form-element__label slds-text-title_caps">Current</legend>
            <div class="slds-form-element__group">
                <div class="slds-form-element__row">
                    <lightning:input type="text" name="city" label="City" value="{!v.taxJurisdiction.city}" class="slds-size_1-of-3" disabled="true"/>
                    <lightning:input type="text" name="county" label="County" value="{!v.taxJurisdiction.county}" class="slds-size_1-of-3" disabled="true"/>
                    <lightning:input type="text" name="state" label="State" value="{!v.taxJurisdiction.state}" class="slds-size_1-of-3" disabled="true"/>
                </div>
            </div>
            
            <legend class="slds-form-element__label slds-text-title_caps">Search</legend>
            <div class="slds-form-element__group">
                <div class="slds-form-element__row">
                    <lightning:input type="text" placeholder="Zip Code" name="zipCode" label="Zip Code" value="{!v.taxJurisdiction.zip}" class="slds-size_1-of-3"/>
                </div>
            </div>
        </div>

        <div class=" slds-m-top_large slds-align_absolute-center" role="group">
            <lightning:button variant="brand" onclick="{!c.doSearch}" iconName="utility:search">
                Search
            </lightning:button>
        </div-->
            
            <div class="slds-form slds-form_compound">
                <!--legend class="slds-form-element__label slds-text-title_caps">Tax Jurisdictions for {!v.taxJurisdiction.zip}</legend-->
                <div class="slds-form-element__group">
                    <div class="slds-form-element__row">
                        <lightning:datatable data="{!v.taxJurisdictions}" columns="{!v.resultColumns}" keyField="cityCode"
                                             hideCheckboxColumn="{!true}" onrowaction="{!c.saveSelected}"/>
                    </div>
                </div>
            </div>
        </div>
    <!-- </aura:if> -->
    <aura:if isTrue="{!v.isLoading}">
        <lightning:spinner aura:id="spinner"/>
    </aura:if>    
</aura:component>